<% content_for :title, "Upload Photo" %>

<div class="form-container">
  <h1>Upload Photo</h1>

  <%= form_with model: @photo, class: "photo-form" do |f| %>
    <% if @photo.errors.any? %>
      <div class="error-list">
        <ul>
          <% @photo.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :title %>
      <%= f.text_field :title, placeholder: "Photo title" %>
    </div>

    <div class="field">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 3, placeholder: "Optional description" %>
    </div>

    <div class="field">
      <%= f.label :image, "Photo file" %>
      <%= f.file_field :image, accept: "image/jpeg,image/png,image/gif,image/webp" %>
      <small class="field-hint">JPEG, PNG, GIF, or WebP — max 20 MB</small>
    </div>

    <div class="form-actions">
      <%= f.submit "Upload", class: "btn btn-primary" %>
      <%= link_to "Cancel", photos_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
