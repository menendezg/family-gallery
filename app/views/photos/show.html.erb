<% content_for :title, @photo.title %>

<div class="photo-show">
  <% if @prev_photo %>
    <%= link_to photo_path(@prev_photo), class: "photo-nav photo-nav-prev" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
      </svg>
    <% end %>
  <% end %>

  <% if @next_photo %>
    <%= link_to photo_path(@next_photo), class: "photo-nav photo-nav-next" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
      </svg>
    <% end %>
  <% end %>

  <img src="<%= url_for(@photo.image) %>"
       class="photo-full"
       alt="<%= @photo.title %>"
       id="photo-main"
       onclick="openLightbox()" />

  <div class="photo-meta">
    <h1><%= @photo.title %></h1>
    <% if @photo.description.present? %>
      <p class="photo-description"><%= @photo.description %></p>
    <% end %>

    <div class="photo-actions">
      <% if @photo.folder.present? %>
        <%= link_to "Back to #{@photo.folder.name}", folder_path(@photo.folder), class: "btn btn-secondary" %>
      <% else %>
        <%= link_to "Back to Gallery", photos_path, class: "btn btn-secondary" %>
      <% end %>
      <% if Current.user&.admin? %>
        <%= button_to "Delete", photo_path(@photo), method: :delete,
            data: { turbo_confirm: "Delete this photo?" },
            class: "btn btn-danger" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
      <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
    </svg>
  </button>
  <img src="<%= url_for(@photo.image) %>" class="lightbox-img" alt="<%= @photo.title %>" onclick="event.stopPropagation()" />
</div>

<script>
  function openLightbox() {
    document.getElementById('lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
