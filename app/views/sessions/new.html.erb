<% content_for :title, "Sign In" %>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">El arcon de fotos de epecuen</h1>
    <p class="auth-title">servidor privado de fotos.</p>
    <p class="auth-subtitle">Inicia sesion para ver las fotos</p>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :username, "Username" %>
        <%= form.text_field :username, required: true, autofocus: true,
            autocomplete: "username", placeholder: "your_username",
            value: params[:username] %>
      </div>

      <div class="field">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, required: true,
            autocomplete: "current-password", placeholder: "Password", maxlength: 72 %>
      </div>

      <%= form.submit "Sign In", class: "btn btn-primary btn-full" %>
    <% end %>
  </div>
</div>
